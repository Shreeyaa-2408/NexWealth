# Copy this file to .env and replace values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./nexwealth.db
# Optional: add a Gemini API key to enable natural-language finance chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FRONTEND_ORIGIN=http://localhost:5173
